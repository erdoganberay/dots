[global]
    # Position
    origin = top-right
    offset = 10x10
    width = (200, 350)
    gap_size = 5

    # Border (flat and sharp, like dwm/st)
    frame_width = 2
    corner_radius = 0
    separator_height = 0

    # Text
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    markup = full
    alignment = left

    # Padding
    padding = 8
    horizontal_padding = 10

    # Icons (set to left if you want them)
    icon_position = off

    # Progress bar (for volume/brightness)
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 0

    # Behavior
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#111111"
    foreground = "#888888"
    frame_color = "#444444"
    timeout = 4

[urgency_normal]
    background = "#111111"
    foreground = "#bbbbbb"
    frame_color = "#444444"
    timeout = 6

[urgency_critical]
    background = "#111111"
    foreground = "#eeeeee"
    # Slight red border so critical notifications stand out; use #444444 to keep it fully flat
    frame_color = "#aa3333"
    timeout = 0
